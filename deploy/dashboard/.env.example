# Copier en .env (ignoré par git) et adapter.

# Nom public du tableau de bord (sans https://) — aussi le seul Host accepté.
ARC_DASHBOARD_HOST=coach.example.org
# Workspace sur l'hôte, monté en lecture seule.
ARC_WORKSPACE_HOST=/home/moi/mon-workspace
# Propriétaire du workspace (id -u / id -g).
ARC_UID=1000
ARC_GID=1000
TZ=Europe/Paris

# Traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
# Obligatoire : middleware d'authentification déjà défini dans Traefik
# (authentik@file, authelia@docker, basic-auth@file…).
TRAEFIK_AUTH_MIDDLEWARE=authentik@file

# Authentik (forward auth) : ajoute la route de l'avant-poste.
# Retirer ces deux lignes avec une autre authentification.
COMPOSE_FILE=compose.yaml:compose.authentik.yaml
# Service Traefik qui pointe vers http://authentik:9000/outpost.goauthentik.io
AUTHENTIK_OUTPOST_SERVICE=sso@file
