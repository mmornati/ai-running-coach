# Données personnelles — jamais versionnées
# Ancrés à la racine : sans le « / » initial, ces motifs excluent aussi
# tests/evals/fixtures/*/activities/ et consorts.
/activities/
/medical/
/nutrition/
/planning/
/rapports/
/gear/
/resources/
# Exports vers des apps tierces (scripts/arc_vanoor.py) : dérivés des plans, personnels
/exports/

# Secrets & tokens
*.token
*.tokens.json
.garminconnect/
.env
.env.local
# Sauvegardes et temporaires de scripts/coach_config.py : `workspace.user.toml.bak` contient
# le sujet ntfy (seul secret sur ntfy.sh), `.mcp.json.bak` la configuration MCP.
*.bak
.arc-*.tmp

# Python
__pycache__/
*.py[cod]
.venv/

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Configs IDE générées par install.sh
.opencode/
.claude/
.gemini/
.cursor/
.windsurf/
.mcp.json
# opencode.json de projet : généré seulement avec des identifiants propres au workspace (#127)
/opencode.json

# Liens symboliques Copilot générés par install.sh (agents/ et skills/ sont la source)
.github/agents
.github/skills

# Overrides personnels de configuration (générés par install.sh)
config/workspace.user.toml

# Build docs
site/
# Journaux des synchronisations automatiques
logs/
# Index SQLite du tableau de bord (dérivé des fichiers, jetable)
/.arc/
# Cache local du hook de design (impeccable)
/.impeccable/hook.cache.json
/.impeccable/review/
# Rendus vidéo (scripts/render_video.py)
/dist/
