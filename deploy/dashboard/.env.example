# Copier en .env (ignoré par git) et adapter.

# Nom public du tableau de bord (sans https://) — aussi le seul Host accepté.
ARC_DASHBOARD_HOST=coach.example.org
# Workspace sur l'hôte, monté en lecture seule.
ARC_WORKSPACE_HOST=/home/moi/mon-workspace
# Propriétaire du workspace (id -u / id -g).
ARC_UID=1000
ARC_GID=1000
TZ=Europe/Paris

# Traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
# Obligatoire : middleware d'authentification déjà défini dans Traefik
# (authentik@file, authelia@docker, basic-auth@file…).
TRAEFIK_AUTH_MIDDLEWARE=authentik@file

# Authentik (forward auth) : ajoute la route de l'avant-poste.
# Retirer ces deux lignes avec une autre authentification.
COMPOSE_FILE=compose.yaml:compose.authentik.yaml
# Service Traefik qui pointe vers http://authentik:9000/outpost.goauthentik.io
AUTHENTIK_OUTPOST_SERVICE=sso@file

# Chat avec le coach en conteneur (optionnel, docs/dashboard/chat.md) : ajouter
# compose.chat.yaml à COMPOSE_FILE, ex. COMPOSE_FILE=compose.yaml:compose.authentik.yaml:compose.chat.yaml
# Lus seulement avec compose.chat.yaml. Montés aux MÊMES chemins que sur l'hôte
# (le workspace pointe vers le moteur par liens absolus).
ARC_ENGINE_HOST=/home/moi/ai-running-coach
ARC_HOME=/home/moi
ARC_LLM_ENV_FILE=/home/moi/.config/ai-running-coach/llm.env

# Révision git de l'image : fournie par scripts/update-docker.sh (git rev-parse HEAD), qui
# s'en sert pour dire si chaque conteneur tourne la version du dépôt. Laisser vide.
ARC_REVISION=
